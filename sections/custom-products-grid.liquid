
{{ 'products-grid.js' | asset_url | script_tag }}

<div class="product-section">
<div class="all-products-container">
  <div class="products-title">
      Tisso vison in the wild
  </div>

  {% assign default_handles = "black-leather-bag,blue-silk-tuxedo,chequered-red-shirt,classic-leather-jacket,classic-varsity-top,dark-denim-top" | split: "," %}

<div class="custom-product-grid">

  {% for i in (0..5) %}
    {% assign index = i | plus: 1 %}
    {% assign setting_id = "product_" | append: index %}
    {% assign selected_product = section.settings[setting_id] %}

    {% if selected_product != blank %}
      {% assign product = all_products[selected_product] %}
    {% else %}
      {% assign fallback_handle = default_handles[i] %}
      {% assign product = all_products[fallback_handle] %}
    {% endif %}     

    {% if product %}
      <div class="product-card"
        data-title="{{ product.title }}"
        data-description="{{ product.description | strip_html }}"
        data-price="{{ product.price | money }}"
        data-variants='{{ product.variants | json }}'
        data-image="{{ product.featured_image | img_url: 'medium' }}">
        <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}" class="product-image">
        <div class="product-selector-{{ forloop.index0 }} product-selector-icon">
        <svg  viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="11" r="11" fill="#F8F8F8" fill-opacity="0.9"/>
        <path d="M11.3457 7.04175V15.5033" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
        <path d="M7.11523 11.2725H15.5768" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
        </svg>
        </div>
     
      </div>
    {% endif %}
  {% endfor %}
</div>
</div>
</div>


<!-- POPUP -->
<div id="product-popup" class="popup" style="display: none;">
  <div class="popup-content">
  <svg id="close-popup"  viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M5.0376 4.94354L13.5229 13.4288" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
<path d="M5.0376 13.4285L13.5229 4.94325" stroke="black" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="round"/>
</svg>
    <div class="popup-top-card">
      <div class="popup-img-container">
      <img id="popup-image" src="" alt=""  />
      </div>
    <div class="popup-container-details">
      <h2 id="popup-title"></h2>
      <p> <span id="popup-price"></span></p>
      <p id="popup-description"></p>
    </div>
    </div>
      <p id="popup-description"></p>
      <div id="selected-color-name" style="margin-bottom: 10px; font-weight: bold;"></div>
      <div id="product-color-container">
      <label for="color">color</label>
<div id="color-options" >
</div>
</div>
<div  id="size-container">
  <label for="size-select">Size</label>
  <select id="size-select" >
  <option value="test"></option>
  </select>
  <div id="size-select-seprator"></div>
  <svg id="custom-arrow-icon" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M2 2L8 8L14 2" stroke="black" stroke-width="1.5" stroke-linecap="square"/>
</svg>
</div>
  <button id="add-to-cart">Add to Cart</button>
</div>
</div>


