{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "nav_logo",
      "label": "Navigation Logo"
    },
    {
      "type": "text",
      "id": "nav_logo_alt_text",
      "label": "Alternative Text for Logo",
      "default": "Store Logo"
    },
    {
      "type": "text",
      "id": "nav_title",
      "label": "Navigation Title",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "text",
      "id": "main_paragraph",
      "label": "Main Paragraph",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "main_button_text",
      "label": "Main Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "main_button_link",
      "label": "Main Button Link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "footer_text_mobile",
      "label": "Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "text",
      "id": "mobile_paragraph",
      "label": "Mobile Paragraph Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}





